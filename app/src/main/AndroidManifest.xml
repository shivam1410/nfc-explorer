<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.NFC" />

    <uses-feature
        android:name="android.hardware.nfc"
        android:required="true" />

    <!--
      Lets the app-picker list launchable apps on API 30+ without the restricted
      QUERY_ALL_PACKAGES permission. This is a visibility declaration, not a permission.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".NfcExplorerApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NfcExplorer">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.NfcExplorer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <!--
          Runs a tag's assigned action with no UI, then finishes.

          exported="true" is REQUIRED for NFC dispatch to reach it, which also means any app can
          start it. TagActionDispatch.shouldAct is the guard; see TagActionDispatchTest.

          NoDisplay + excludeFromRecents + noHistory so a tap never shows a frame or leaves a task
          behind. The tech filter is narrowed to NfcA/MifareUltralight rather than using
          TAG_DISCOVERED, so the app claims fewer unrelated tags.
        -->
        <activity
            android:name=".TagActionActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />
        </activity>

    </application>

</manifest>
