<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.NFC" />

    <!-- Update check only: one unauthenticated GET against the GitHub releases API. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.hardware.nfc"
        android:required="true" />

    <!--
      Lets the app-picker list launchable apps on API 30+ without the restricted
      QUERY_ALL_PACKAGES permission. This is a visibility declaration, not a permission.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".NfcExplorerApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NfcExplorer">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.NfcExplorer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <!--
          Runs a tag's assigned action with no UI, then finishes.

          exported="true" is REQUIRED for NFC dispatch to reach it, which also means any app can
          start it. TagActionDispatch.shouldAct is the guard; see TagActionDispatchTest.

          Theme.NfcExplorer.Trigger + excludeFromRecents + noHistory so a tap never shows a frame or
          leaves a task behind. NOT Theme.NoDisplay: that requires finish() before onResume() returns,
          which an activity that must read a store and connect to a tag first cannot do — see the
          theme's own comment. The tech filter is narrowed to NfcA/MifareUltralight rather than using
          TAG_DISCOVERED, so the app claims fewer unrelated tags.
        -->
        <activity
            android:name=".TagActionActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.NfcExplorer.Trigger">
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />
        </activity>

        <!--
          Reads the notification shade so a toggle can tell whether the app it targets is currently
          running. Requires a grant the user makes by hand in system settings; until then
          ActiveNotificationProbe reports Unavailable rather than guessing "not running".
        -->
        <service
            android:name=".data.system.TrackingNotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          Dispatches drag gestures. Also user-granted, also inert until granted.
        -->
        <service
            android:name=".data.system.GestureDispatchService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/gesture_accessibility_service" />
        </service>

    </application>

</manifest>
